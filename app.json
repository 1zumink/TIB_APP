{
  "expo": {
    "name": "TIB",
    "slug": "tib-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "tib",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0A0A",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#FF0044",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tib.app"
    },
    "android": {
      "package": "com.tib.app",
      "adaptiveIcon": {
        "backgroundColor": "#FF0044",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sharing",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "TIB нужен доступ к галерее, чтобы поставить фото на карточку.",
          "cameraPermission": "TIB нужен доступ к камере, чтобы снять фото для карточки."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/TIB_APP"
    }
  }
}
